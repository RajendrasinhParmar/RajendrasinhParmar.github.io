{
  "name": "rajendrasinhparmar-github-io",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "mkdir -p public/assets/images && cp -f src/assets/images/sudonovagame.png src/assets/images/sudonova.png public/assets/images/ 2>/dev/null || true",
    "build": "astro check && astro build && pagefind --site dist && cp -r dist/pagefind public/ && jampack ./dist",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check . --plugin=prettier-plugin-astro --plugin=prettier-plugin-tailwindcss",
    "format": "prettier --write . --plugin=prettier-plugin-astro --plugin=prettier-plugin-tailwindcss",
    "cz": "cz",
    "prepare": "husky install",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@divriots/jampack": "^0.34.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.1.0",
    "github-slugger": "^2.0.0",
    "hastscript": "^9.0.1",
    "mermaid": "^11.12.1",
    "rehype-callouts": "^2.2.0",
    "rehype-mermaid": "^3.0.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.4.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/github-slugger": "^1.3.0",
    "@typescript-eslint/parser": "^6.21.0",
    "astro-eslint-parser": "^0.15.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.29.1",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.3.2",
    "prettier-plugin-astro": "^0.12.3",
    "prettier-plugin-tailwindcss": "^0.8.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
